#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0) readonly buffer X { float x[]; };
layout(set=0,binding=1) readonly buffer W { float w[]; };
layout(set=0,binding=2) writeonly buffer Y { float y[]; };
void main() {
    uint i=gl_GlobalInvocationID.x;
    if (i>=480) return;
    uint channel=i/96, freq=i%96;
    float sum=0.0;
    for (uint k=0;k<160;++k) sum+=x[k*96+freq]*w[channel*160+k];
    y[i]=sum;
}
